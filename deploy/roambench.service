[Unit]
Description=RoamBench
After=network-online.target
Wants=network-online.target

[Service]
# Example unit for a host-level deployment.
# Replace the user and paths before installing it.
Type=simple
User=roambench
Group=roambench
WorkingDirectory=/opt/roambench
Environment=HOME=/home/roambench
ExecStart=/usr/local/bin/roambench --config /etc/roambench/roambench.toml
Restart=always
RestartSec=3

# Host profile: approximately 16 GiB RAM.
MemoryAccounting=yes
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=1G
TasksAccounting=yes
TasksMax=384
OOMPolicy=continue
Delegate=cpu io memory pids
DelegateSubgroup=supervisor

[Install]
WantedBy=multi-user.target
