[Unit]
Description=RoamBench
After=network-online.target
Wants=network-online.target

[Service]
# Example unit: replace the user and paths for your deployment.
Type=simple
User=roambench
Group=roambench
WorkingDirectory=/opt/roambench
Environment=HOME=/home/roambench
# Optional: keep auth settings in a protected env file instead of the main config.
# EnvironmentFile=-/etc/roambench/roambench.env
ExecStart=/usr/local/bin/roambench --config /etc/roambench/roambench.toml
Restart=always
RestartSec=3

# Bound the complete RoamBench task pool, including terminal descendants.
MemoryAccounting=yes
MemoryHigh=40%
MemoryMax=50%
MemorySwapMax=1G
TasksAccounting=yes
TasksMax=384
OOMPolicy=continue

# Allow RoamBench to place each new terminal in its own cgroup. The main
# server stays in a leaf subgroup so delegated controllers can be enabled.
Delegate=cpu io memory pids
DelegateSubgroup=supervisor

[Install]
WantedBy=default.target
