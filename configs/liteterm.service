[Unit]
Description=RoamBench
After=network-online.target
Wants=network-online.target

[Service]
# Example unit: replace the user and paths for your deployment.
Type=simple
User=roambench
Group=roambench
WorkingDirectory=/opt/roambench
Environment=HOME=/home/roambench
# Optional: keep auth settings in a protected env file instead of the main config.
# EnvironmentFile=-/etc/liteterm/liteterm.env
ExecStart=/usr/local/bin/liteterm --config /etc/liteterm/liteterm.toml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
